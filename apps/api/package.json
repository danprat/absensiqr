{
  "name": "@absensiqr/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AbsensiQR API - Cloudflare Workers backend with Hono",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "attendance",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.7",
    "jose": "^6.1.3",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251202.0",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.51.0"
  }
}
